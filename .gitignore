# Python/build artifacts
__pycache__/
*.py[cod]
*.egg-info/

# Logs
*.log

# Generated datasets
experiments/counter/data/*.pkl
# Local derived climate grids; regenerate from the documented CDS/ERA5-Land source.
experiments/counter/data/*.nc

# Experiment run outputs and model artifacts
experiments/counter/results/*/
experiments/counter_v2/
!experiments/counter/results/img/
!experiments/counter/results/img/**
experiments/counter_v2/results/
experiments/counter_v2/folder/
experiments/counter/additional_results_not_for_commit/
experiments/counter/**/__pycache__/
experiments/counter/job_execution_*.log
experiments/**/results/**/*.pkl
experiments/**/results/**/*.pth
experiments/**/results/**/*_loss.png
experiments/**/results/**/job.log

# Reproducible classifier pipeline: retain compact paper-facing tables, but not
# regenerated inputs, fitted weights, resumable fit checkpoints, or backups.
experiments/classifier/paper_results/input/*.csv.gz
experiments/classifier/paper_results/models/
experiments/classifier/paper_results/checkpoints/
experiments/classifier/paper_results/*.partial.csv
experiments/classifier/paper_results_backup_*/

# LaTeX build intermediates (source, bibliography, figures, and final PDFs are
# handled separately from these temporary files).
paper/*.aux
paper/*.bcf
paper/*.blg
paper/*.log
paper/*.out
paper/*.run.xml
paper/*.spl
paper/*.xdv
